{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "PetClaw Web Export (HTML5 Game)",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8000", "--directory", "godot_project/export/web"],
      "port": 8000
    },
    {
      "name": "PetClaw MCP Quality Server",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["tools/quality/petclaw_mcp_server.py"],
      "port": 8765
    },
    {
      "name": "Godot Editor",
      "runtimeExecutable": "/Applications/Godot.app/Contents/MacOS/Godot",
      "runtimeArgs": ["--path", "godot_project"],
      "port": 6007
    }
  ]
}
